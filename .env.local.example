# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Site URL (requerido para OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth: se configura en Supabase Dashboard, NO aquí
# Ver: Supabase Dashboard > Authentication > Providers > Google

# --- Emails e informes programados (Fase 6). Solo servidor: nunca con prefijo NEXT_PUBLIC ---
# API key de Resend. Sin ella (o sin EMAIL_FROM) no se envía nada: cada envío queda como "skipped_no_provider".
RESEND_API_KEY=
# Remitente, de un dominio verificado en Resend. Formato: Goospe <hola@tudominio.cl>
EMAIL_FROM=
# Opcional: a dónde llegan las respuestas de la gente (si no, al remitente).
EMAIL_REPLY_TO=
# Secreto (32+ caracteres al azar) que firma los enlaces de baja. Sin él no sale ningún email con baja.
EMAIL_LINK_SECRET=
# Secreto (16+ caracteres) de las rutas /api/cron/*. Vercel Cron lo envía solo; sin él responden 401.
CRON_SECRET=
# Opcional: tope de informes semanales con IA por ejecución del cron (por defecto 25; 0 = solo números).
WEEKLY_REPORT_MAX_AI=
